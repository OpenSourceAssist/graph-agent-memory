      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Bolt driver opens a connection pool and\nissues Cypher directly. Model calls made by\nthe embedding/extraction providers you\nconfigure can be local or remote -- Bolt\nalone does not disable outbound requests.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "note-bolt",
      "originalText": "Bolt driver opens a connection pool and\nissues Cypher directly. Model calls made by\nthe embedding/extraction providers you\nconfigure can be local or remote -- Bolt\nalone does not disable outbound requests.",
      "autoResize": true,
      "lineHeight": 1.25
    },
